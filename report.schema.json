{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eryx-report:v1",
  "title": "Eryx Report v1",
  "type": "object",
  "required": ["schema_version", "status", "exit_code", "summary", "diagnostics"],
  "properties": {
    "schema_version": {"const": "eryx-report/v1"},
    "eryx": {"type": "object", "required": ["commit", "dirty"], "properties": {"commit": {"type": ["string", "null"]}, "dirty": {"type": ["boolean", "null"]}}},
    "status": {"enum": ["passed", "violations", "error"]},
    "exit_code": {"enum": [0, 1, 2]},
    "run_id": {"type": "string"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "summary": {"type": "object", "required": ["diagnostics", "infrastructure_errors"], "properties": {"diagnostics": {"type": "integer", "minimum": 0}, "infrastructure_errors": {"type": "integer", "minimum": 0}}},
    "coverage": {"type": "object", "properties": {
      "tree_objects": {"type": "array", "items": {"type": "object", "required": ["object_id", "path", "kind", "path_checked"], "properties": {
        "object_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"}, "path": {"type": "string"},
        "kind": {"enum": ["file", "directory", "symlink", "other"]},
        "path_checked": {"type": "boolean"},
        "content": {"type": "object", "required": ["presidio", "secret"], "properties": {
          "presidio": {"enum": ["scanned", "skipped", "excluded_by_policy", "unconfirmed", "selected", "not_selected"]},
          "secret": {"enum": ["scanned", "skipped", "excluded_by_policy", "unconfirmed", "selected", "not_selected"]}}}
      }}, "uniqueItems": true},
      "tree_count": {"type": "integer", "minimum": 0},
      "path_references": {"type": "array", "items": {"type": "object", "required": ["reference_id", "source_object_id", "path", "line", "column", "span_length", "absolute"], "properties": {
        "reference_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "source_object_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "path": {"type": "string"}, "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}, "span_length": {"type": "integer", "minimum": 2},
        "absolute": {"type": "boolean"}}}},
      "path_reference_count": {"type": "integer", "minimum": 0},
      "tree_incomplete_count": {"type": "integer", "minimum": 0},
      "presidio_inputs": {"type": "array", "items": {"type": "string"}},
      "presidio_scanned": {"type": "array", "items": {"type": "string"}},
      "presidio_skipped": {"type": "array", "items": {"type": "string"}},
      "presidio_excluded": {"type": "array", "items": {"type": "string"}},
      "presidio_excluded_count": {"type": "integer", "minimum": 0},
      "presidio_unconfirmed": {"type": "array", "items": {"type": "string"}},
      "presidio_count": {"type": "integer", "minimum": 0},
      "presidio_skipped_count": {"type": "integer", "minimum": 0},
      "secret_inputs": {"type": "array", "items": {"type": "string"}},
      "secret_scanned": {"type": "array", "items": {"type": "string"}},
      "secret_skipped": {"type": "array", "items": {"type": "string"}},
      "secret_count": {"type": "integer", "minimum": 0},
      "secret_skipped_count": {"type": "integer", "minimum": 0},
      "secret_unconfirmed": {"type": "array", "items": {"type": "string"}},
      "secret_excluded": {"type": "array", "items": {"type": "string"}},
      "secret_excluded_count": {"type": "integer", "minimum": 0}
    }},
    "tools": {"type": "array", "items": {"type": "object", "required": ["name", "tool", "status"], "properties": {"status": {"enum": ["passed", "violations", "error", "blocked"]}}}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "report_path": {"type": "string"},
    "latest_report_path": {"type": "string"}
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["tool", "rule", "severity", "path", "line", "column", "message", "fingerprint"],
      "properties": {
        "tool": {"type": "string"}, "rule": {"type": "string"}, "severity": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "column": {"type": ["integer", "null"], "minimum": 1},
        "message": {"type": "string"}, "symbol": {"type": ["string", "null"]},
        "object_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{24}$"},
        "reference_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "span_length": {"type": "integer", "minimum": 1},
        "documentation_url": {"type": ["string", "null"]}, "fingerprint": {"type": "string"},
        "is_infrastructure_error": {"type": "boolean"}, "rule_is_adapter_category": {"type": "boolean"}
      }
    }
  }
}
