{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quard-report:v1",
  "title": "Quard Report v1",
  "type": "object",
  "required": ["schema_version", "status", "exit_code", "summary", "diagnostics"],
  "properties": {
    "schema_version": {"const": "quard-report/v1"},
    "quard": {"type": "object", "required": ["commit", "dirty"], "properties": {"commit": {"type": ["string", "null"]}, "dirty": {"type": ["boolean", "null"]}}},
    "status": {"enum": ["passed", "violations", "error"]},
    "exit_code": {"enum": [0, 1, 2]},
    "run_id": {"type": "string"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "summary": {"type": "object", "required": ["diagnostics", "infrastructure_errors"], "properties": {"diagnostics": {"type": "integer", "minimum": 0}, "infrastructure_errors": {"type": "integer", "minimum": 0}}},
    "coverage": {"type": "object", "properties": {"production": {"type": "array", "items": {"type": "string"}}, "tests": {"type": "array", "items": {"type": "string"}}, "excluded_directories": {"type": "array", "items": {"type": "string"}}, "excluded_gateways": {"type": "array", "items": {"type": "string"}}, "lcom4": {"type": "object", "required": ["mode", "requested", "selected_files", "analyzed_files"], "properties": {"mode": {"enum": ["full", "selected", "skipped", "invalid"]}, "requested": {"type": ["string", "null"]}, "selected_files": {"type": "array", "items": {"type": "string"}}, "analyzed_files": {"type": "array", "items": {"type": "string"}}}}}},
    "tools": {"type": "array", "items": {"type": "object", "required": ["name", "tool", "status"], "properties": {"status": {"enum": ["passed", "violations", "error", "blocked", "skipped"]}}}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "report_path": {"type": "string"},
    "latest_report_path": {"type": "string"}
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["tool", "rule", "severity", "path", "line", "column", "message", "fingerprint"],
      "properties": {
        "tool": {"type": "string"}, "rule": {"type": "string"}, "severity": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "column": {"type": ["integer", "null"], "minimum": 1},
        "message": {"type": "string"}, "symbol": {"type": ["string", "null"]},
        "documentation_url": {"type": ["string", "null"]}, "fingerprint": {"type": "string"},
        "is_infrastructure_error": {"type": "boolean"}, "rule_is_adapter_category": {"type": "boolean"}
      }
    }
  }
}
